id: main
type: messaging
start: oauth_status
nodes:
  # Provider-agnostic sign-in: the card is given only the provider's URLs +
  # public client_id (set at setup time) and builds the conventional OAuth 2.0
  # authorization-code consent URL itself. Swap providers by changing auth_url /
  # client_id / scopes only — no flow logic or component changes. The token
  # exchange (which needs the client_secret) stays in the OAuth provider
  # extension; the card never sees a secret.
  #
  # Full GitHub repos flow preserved in main.ygtc.full.bak.
  oauth_status:
    component.exec:
      component: "ai.greentic.component-oauth-card"
      operation: oauth_card.handle_message
      input:
        mode: "start-sign-in"
        provider_id: "github"
        subject: "demo-user"
        scopes:
          - "repo"
          - "read:org"
        auth_url: "https://github.com/login/oauth/authorize"
        client_id: "REPLACE_WITH_GITHUB_CLIENT_ID"
        redirect_uri: "http://localhost:8080/v1/oauth/ingress/oauth-oidc-executable/demo/default"
    routing:
      - out: true
