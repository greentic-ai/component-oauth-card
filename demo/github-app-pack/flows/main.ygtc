id: main
type: messaging
start: oauth_status
nodes:
  # 1) The OAuth card is the main event: ensure a usable GitHub token for this
  #    subject. The operator resolves/refreshes via the broker; the card decides
  #    ok / needs-sign-in / needs-refresh and exposes the raw token as
  #    `access_token` for downstream nodes. (Token is acquired via the live
  #    runner; see the repo README "Demo".)
  oauth_status:
    component.exec:
      component: "ai.greentic.component-oauth-card"
      operation: oauth_card.handle_message
      input:
        mode: "ensure-token"
        provider_id: "github"
        subject: "{{in.input.metadata.subject}}"
        scopes:
          - "repo"
          - "read:org"
        allow_auto_sign_in: true
    routing:
      - to: call_repos

  # 2) Call the generated GitHub API component (OpenAPI -> wasm -> wac-composed).
  #    The token is injected as `access_token` (the tool prefixes "Bearer ").
  call_repos:
    component.exec:
      component: "github_api"
      operation: list_authenticated_user_repos
      input:
        access_token: "{{node.oauth_status.result.access_token}}"
        visibility: "{{in.input.metadata.visibility}}"
        per_page: 20
    routing:
      - to: render_repo_list_card

  # 3) Render the GitHub result as an Adaptive Card for webchat-gui.
  render_repo_list_card:
    component.exec:
      component: "ai.greentic.component-adaptive-card"
      operation: card
      input:
        card_source: asset
        card_spec:
          asset_path: assets/repo_list_card.json
        payload:
          request: "{{in.input.metadata}}"
          result: "{{node.call_repos.result.structured_content}}"
    routing:
      - out: true
