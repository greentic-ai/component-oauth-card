# Filled setup answers (contains client_id/client_secret) — keep the .example
/setup.answers.json

# Copied/built pack artifact (produced by `greentic-pack build`)
/packs/*.gtpack

# github-app-pack build artifacts (regenerated: make wasm / greentic-mcp-gen / wac / greentic-pack build)
/github-app-pack/components/**/*.wasm
/github-app-pack/routers/*.wasm
/github-app-pack/dist/
/github-app-pack/pack.lock.cbor
/github-app-pack/.greentic/

# Provider packs pulled from GHCR by `gtc setup`
/providers/
/.providers/

# Generated by gtc setup / greentic-start
/resolved/
/state/
/logs/
/assets/
/dist/
/.greentic/
/bundle.lock.json
/tenants/
