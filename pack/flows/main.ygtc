id: main
type: messaging
start: microsoft_oauth_card
nodes:
  # Render the standard OAuth status card for a Microsoft (Entra / identity
  # platform) connection. The operator resolves the token for this provider +
  # subject (refreshing via the broker when offline_access was granted) and
  # injects it into the component; the card decides connected / needs-sign-in /
  # needs-refresh and emits the sign-in / status card for webchat-gui.
  microsoft_oauth_card:
    component.exec:
      component: ai.greentic.component-oauth-card
      operation: oauth_card.handle_message
      input:
        mode: status-card
        provider_id: microsoft
        subject: "user"
        connection_name: microsoft
        scopes:
          - offline_access
          - openid
          - profile
          - User.Read
    routing:
      - out: true
